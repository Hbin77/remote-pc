# === Server ===
SERVER_HOST=0.0.0.0
SERVER_PORT=8900
SECRET_KEY=change-this-to-random-secret

# === Auth ===
ADMIN_USERNAME=admin
# Generate with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=$2b$12$EXAMPLE_HASH_REPLACE_THIS

# === JWT ===
JWT_SECRET=change-this-to-random-jwt-secret
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# === Agent ===
AGENT_SECRET=change-this-to-agent-secret
AGENT_ID=my-desktop-001
RELAY_URL=ws://localhost:8900

# === Performance ===
DEFAULT_FPS=24
DEFAULT_QUALITY=50
DEFAULT_SCALE=0.75
